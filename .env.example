# Email notifications (src/utils/emailNotify.ts)
#
# Uses EmailJS (https://www.emailjs.com) for real, backend-free email sending
# from the browser — no server required, consistent with this project's
# GitHub Pages static deployment. One EmailJS account/Service ID is shared
# by two separate templates below (different message content, same sender).
#
# Setup:
#   1. Create a free EmailJS account (free tier: 200 emails/month)
#   2. Add an Email Service (e.g. connect your Gmail) -> gives you a Service ID
#      (shared by both templates — fill in VITE_EMAILJS_SERVICE_ID once)
#   3. Create Template 1 — winner notification — with variables:
#      {{to_email}}, {{vendor_name}}, {{tender_title}}, {{amount}},
#      {{contract_id}} -> gives you VITE_EMAILJS_TEMPLATE_ID
#   4. Create Template 2 — Restricted Bidding invitation (Art. 3(9)) — with
#      variables: {{to_email}}, {{vendor_name}}, {{tender_title}},
#      {{deadline}} -> gives you VITE_EMAILJS_INVITATION_TEMPLATE_ID
#   5. Copy your Public Key from Account > General
#   6. Copy this file to .env.local and fill in the values below
#      (.env.local is already gitignored — never commit real keys)
#
# Each notification checks its own template ID independently — if only one
# template exists, only that notification type works; the other correctly
# shows "not configured" rather than pretending to have sent anything.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_INVITATION_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
