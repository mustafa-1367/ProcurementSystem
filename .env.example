# Winner-notification email (src/utils/emailNotify.ts)
#
# Uses EmailJS (https://www.emailjs.com) for real, backend-free email sending
# from the browser — no server required, consistent with this project's
# GitHub Pages static deployment.
#
# Setup:
#   1. Create a free EmailJS account (free tier: 200 emails/month)
#   2. Add an Email Service (e.g. connect your Gmail) -> gives you a Service ID
#   3. Create an Email Template with variables: {{to_email}}, {{vendor_name}},
#      {{tender_title}}, {{amount}}, {{contract_id}} -> gives you a Template ID
#   4. Copy your Public Key from Account > General
#   5. Copy this file to .env.local and fill in the three values below
#      (.env.local is already gitignored — never commit real keys)
#
# If these are left unset, the app does NOT send a fake "success" — the
# winning bidder's award card will show "Email notifications not configured"
# instead.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
